# ==============================================================================
# RESTAURANT SAAS PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or configure in your deployment platform (Vercel, Cloud Run).
# Never commit real secrets to source control.

# ------------------------------------------------------------------------------
# 1. RUNTIME & HOSTING
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (NEVER EXPOSE TO BROWSER / DO NOT PREFIX WITH VITE_)
# ------------------------------------------------------------------------------
# Google Gemini API key for server-side AI Concierge, Copilot & Analytics Insights
# Required for live generative AI; app gracefully falls back to deterministic rules if empty.
GEMINI_API_KEY=""

# Supabase Server Service Role (Used exclusively by backend administration / edge functions)
SUPABASE_SERVICE_ROLE_KEY=""

# Razorpay / Payment Gateway Server Credentials (Required for server-side order creation & HMAC verification)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
PAYMENT_KEY_SECRET=""
PAYMENT_WEBHOOK_SECRET=""
PAYMENT_PROVIDER_MODE="LIVE"

# ------------------------------------------------------------------------------
# 3. PUBLIC FRONTEND VARIABLES (SAFE TO EXPOSE IN BROWSER / PREFIXED WITH VITE_)
# ------------------------------------------------------------------------------
# Supabase Public Anonymous Configuration
# If left empty, the application runs seamlessly in offline-resilient DEMO MODE.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Multi-Tenant Default Branch / Restaurant Slug
VITE_DEFAULT_RESTAURANT_SLUG="kings-of-wings"
VITE_DEFAULT_RESTAURANT_ID="rest-kow-blr-01"

# Razorpay Public Client Key (Key ID ONLY - NEVER KEY SECRET)
VITE_RAZORPAY_KEY_ID=""
VITE_PAYMENT_KEY_ID=""
VITE_PAYMENT_PROVIDER_MODE="LIVE"

# Production Feature Flags (Optional client-side overrides)
VITE_FEATURE_AI="true"
VITE_FEATURE_PAYMENTS="true"
VITE_FEATURE_INVENTORY="true"
VITE_FEATURE_FORECASTING="true"
VITE_FEATURE_MULTI_TENANT="true"
